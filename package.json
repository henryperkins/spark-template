{
    "name": "spark-template",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "kill": "fuser -k 5000/tcp",
        "build": "tsc --noEmit && vite build",
        "lint": "eslint .",
        "test": "vitest run",
        "optimize": "vite optimize",
        "preview": "vite preview",
        "cf:dev": "npm run build && wrangler dev",
