# Environment template for Agentic RAG Starter
# Copy this file to `.env` for local development.
# All VITE_* variables are exposed to the client bundle; keep secrets in a secure store for production.

# ---------------------------------------------------------------------------
# Core app
# ---------------------------------------------------------------------------

VITE_APP_ENV=development
VITE_DEFAULT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# LLM behavior (optional overrides; defaults in src/lib/config.ts)
# ---------------------------------------------------------------------------

# VITE_LLM_MAX_RETRIES=3
# VITE_LLM_RETRY_BACKOFF_MS=300
# VITE_LLM_TIMEOUT_MS=20000
# VITE_LLM_RATE_LIMIT_QPS=5
# VITE_LLM_RATE_LIMIT_BURST=10
# VITE_LLM_ENABLE_STREAMING=false

# ---------------------------------------------------------------------------
# Truncation and token budgets (optional)
# ---------------------------------------------------------------------------

# VITE_TOKEN_CHAR_RATIO=4.0
# VITE_CRITIC_MAX_TOKENS=900
# VITE_REACT_THOUGHT_MAX_TOKENS=150
# VITE_REACT_REFINE_MAX_TOKENS=800
# VITE_EXPANSION_MAX_TOKENS=600
# VITE_PLANNER_MAX_TOKENS=500
# VITE_CLASSIFIER_MAX_TOKENS=300
# VITE_ROUTER_MAX_TOKENS=200

# ---------------------------------------------------------------------------
# Retrieval defaults (optional)
# ---------------------------------------------------------------------------

# VITE_RETRIEVAL_MAX_RESULTS=5
# VITE_RETRIEVAL_PER_DOC_LIMIT=2
# VITE_RETRIEVAL_DEDUPE_BY_DOC=true
# VITE_RETRIEVAL_MIN_RELEVANCE=0.1
# VITE_RRF_K=60
# VITE_NORMALIZE_SCORES=true

# ---------------------------------------------------------------------------
# Prompt & safety controls (optional)
# ---------------------------------------------------------------------------

# VITE_ENFORCE_JSON_ONLY=true
# VITE_SANITIZE_QUERIES=true
# VITE_MAX_USER_QUERY_CHARS=500
# VITE_REDACT_PII=false

# ---------------------------------------------------------------------------
# Agent temperatures (optional)
# ---------------------------------------------------------------------------

# VITE_TEMP_CLASSIFIER=0.3
# VITE_TEMP_PLANNER=0.4
# VITE_TEMP_ROUTER=0.2
# VITE_TEMP_EXPANSION=0.6
# VITE_TEMP_CRITIC=0.2
# VITE_TEMP_REACT_THOUGHT=0.3
# VITE_TEMP_REACT_REFINE=0.4

# ---------------------------------------------------------------------------
# Azure OpenAI (optional but recommended for production)
# ---------------------------------------------------------------------------
# Endpoint example: https://your-resource.openai.azure.com/

VITE_AZURE_OPENAI_ENDPOINT=
VITE_AZURE_OPENAI_DEPLOYMENT=
VITE_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Azure OpenAI key is sensitive.
# For local dev you may set it here; for Cloudflare Workers, use:
#   wrangler secret put VITE_AZURE_OPENAI_KEY

VITE_AZURE_OPENAI_KEY=

# ---------------------------------------------------------------------------
# Azure AI Search (optional)
# ---------------------------------------------------------------------------
# Endpoint example: https://your-search.search.windows.net

VITE_AZURE_SEARCH_ENDPOINT=
VITE_AZURE_SEARCH_INDEX=
VITE_AZURE_SEARCH_KEY=

# ---------------------------------------------------------------------------
# Cloudflare KV / API (only if using direct REST KV access)
# ---------------------------------------------------------------------------

VITE_CLOUDFLARE_ACCOUNT_ID=
VITE_CLOUDFLARE_KV_NAMESPACE_ID=
VITE_CLOUDFLARE_API_TOKEN=

# If true, prefer Worker KV bindings/runtime when available.
# VITE_USE_WORKER_KV=true

# ---------------------------------------------------------------------------
# Observability / Worker-side secrets (local dev only)
# ---------------------------------------------------------------------------
# In production on Cloudflare Workers, configure via:
#   wrangler secret put LOGS_API_KEY
#   wrangler secret put KV_API_KEY
#   wrangler secret put AZURE_API_KEY
#   wrangler secret put MIGRATION_KEY
#   wrangler secret put OPENAI_API_KEY
#   wrangler secret put VITE_AZURE_OPENAI_KEY
#   wrangler secret put VITE_AZURE_SEARCH_KEY
#
# For local development, you may define them here to hit local/remote mocks.

LOGS_API_KEY=
KV_API_KEY=
AZURE_API_KEY=
MIGRATION_KEY=
OPENAI_API_KEY=